  {
   "n": 31,
   "sura": 18,
   "sura_name": "الكهف",
   "aya": 75,
   "start_of_sura": false,
   "words": "قَالَ أَلَمْ أَقُل لَّكَ إِنَّكَ",
   "end_sura": 19,
   "end_sura_name": "مريم",
   "end_aya": 98,
   "end_of_sura": true,
   "end_words": "أَحَدٍ أَوْ تَسْمَعُ لَهُمْ رِكْزًا"
