  {
   "n": 18,
   "sura": 7,
   "sura_name": "الأعراف",
   "aya": 171,
   "start_of_sura": false,
   "words": "وَإِذْ نَتَقْنَا الْجَبَلَ فَوْقَهُمْ كَأَنَّهُ",
   "end_sura": 8,
   "end_sura_name": "الأنفال",
   "end_aya": 40,
   "end_of_sura": false,
   "end_words": "مَوْلَاكُمْ نِعْمَ الْمَوْلَىٰ وَنِعْمَ النَّصِيرُ"
  },
  {
   "n": 19,
   "sura": 8,
   "sura_name": "الأنفال",
   "aya": 41,
   "start_of_sura": false,
   "words": "وَاعْلَمُوا أَنَّمَا غَنِمْتُم مِّن شَيْءٍ",
