   "end_sura_name": "الرعد",
   "end_aya": 18,
   "end_of_sura": false,
   "end_words": "الْحِسَابِ وَمَأْوَاهُمْ جَهَنَّمُ وَبِئْسَ الْمِهَادُ"
  },
  {
   "n": 26,
   "sura": 13,
   "sura_name": "الرعد",
   "aya": 19,
   "start_of_sura": false,
   "words": "أَفَمَن يَعْلَمُ أَنَّمَا أُنزِلَ إِلَيْكَ",
