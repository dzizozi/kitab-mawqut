  {
   "n": 32,
   "sura": 20,
   "sura_name": "طه",
   "aya": 1,
   "start_of_sura": true,
   "words": "طه مَا أَنزَلْنَا عَلَيْكَ الْقُرْآنَ",
   "end_sura": 20,
   "end_sura_name": "طه",
   "end_aya": 135,
   "end_of_sura": true,
   "end_words": "أَصْحَابُ الصِّرَاطِ السَّوِيِّ وَمَنِ اهْتَدَىٰ"
