  {
   "n": 22,
   "sura": 10,
   "sura_name": "يونس",
   "aya": 26,
   "start_of_sura": false,
   "words": "لِّلَّذِينَ أَحْسَنُوا الْحُسْنَىٰ وَزِيَادَةٌ وَلَا",
