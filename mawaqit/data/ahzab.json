  {
   "n": 28,
   "sura": 16,
   "sura_name": "النحل",
   "aya": 51,
   "start_of_sura": false,
   "words": "وَقَالَ اللَّهُ لَا تَتَّخِذُوا إِلَٰهَيْنِ",
