  {
   "end_of_sura": false,
   "end_sura": 28,
   "end_sura_name": "القصص",
   "end_aya": 50,
   "end_words": "اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ",
   "n": 39,
   "sura": 27,
   "sura_name": "النمل",
   "aya": 56,
   "start_of_sura": false,
   "words": "فَمَا كَانَ جَوَابَ قَوْمِهِ إِلَّا"
