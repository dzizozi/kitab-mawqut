   "end_sura": 29,
   "end_sura_name": "العنكبوت",
   "end_aya": 45,
   "end_words": "أَكْبَرُ وَاللَّهُ يَعْلَمُ مَا تَصْنَعُونَ",
   "n": 40,
   "sura": 28,
   "sura_name": "القصص",
   "aya": 51,
   "start_of_sura": false,
   "words": "وَلَقَدْ وَصَّلْنَا لَهُمُ الْقَوْلَ لَعَلَّهُمْ"
