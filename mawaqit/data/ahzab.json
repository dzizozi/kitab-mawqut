   "end_sura_name": "التوبة",
   "end_aya": 92,
   "end_of_sura": false,
   "end_words": "حَزَنًا أَلَّا يَجِدُوا مَا يُنفِقُونَ"
  },
  {
   "n": 21,
   "sura": 9,
   "sura_name": "التوبة",
   "aya": 93,
   "start_of_sura": false,
   "words": "إِنَّمَا السَّبِيلُ عَلَى الَّذِينَ يَسْتَأْذِنُونَكَ",
