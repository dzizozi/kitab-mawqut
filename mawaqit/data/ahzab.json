{
 "hafs": [
  {
   "n": 1,
   "sura": 1,
   "sura_name": "الفاتحة",
   "aya": 1,
   "start_of_sura": true,
   "words": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ",
   "end_sura": 2,
   "end_sura_name": "البقرة",
   "end_aya": 74,
   "end_of_sura": false,
   "end_words": "وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ"
  },
  {
   "n": 2,
   "sura": 2,
   "sura_name": "البقرة",
   "aya": 75,
   "start_of_sura": false,
   "words": "أَفَتَطْمَعُونَ أَن يُؤْمِنُوا لَكُمْ وَقَدْ",
   "end_sura": 2,
   "end_sura_name": "البقرة",
   "end_aya": 141,
   "end_of_sura": false,
   "end_words": "وَلَا تُسْأَلُونَ عَمَّا كَانُوا يَعْمَلُونَ"
  },
  {
   "n": 3,
   "sura": 2,
   "sura_name": "البقرة",
   "aya": 142,
   "start_of_sura": false,
   "words": "سَيَقُولُ السُّفَهَاءُ مِنَ النَّاسِ مَا",
   "end_sura": 2,
   "end_sura_name": "البقرة",
   "end_aya": 202,
   "end_of_sura": false,
   "end_words": "مِّمَّا كَسَبُوا وَاللَّهُ سَرِيعُ الْحِسَابِ"
  },
  {
   "n": 4,
   "sura": 2,
   "sura_name": "البقرة",
   "aya": 203,
   "start_of_sura": false,
   "words": "وَاذْكُرُوا اللَّهَ فِي أَيَّامٍ مَّعْدُودَاتٍ",
   "end_sura": 2,
   "end_sura_name": "البقرة",
   "end_aya": 252,
   "end_of_sura": false,
   "end_words": "عَلَيْكَ بِالْحَقِّ وَإِنَّكَ لَمِنَ الْمُرْسَلِينَ"
  },
  {
   "n": 5,
   "sura": 2,
   "sura_name": "البقرة",
   "aya": 253,
   "start_of_sura": false,
   "words": "تِلْكَ الرُّسُلُ فَضَّلْنَا بَعْضَهُمْ عَلَىٰ",
   "end_sura": 3,
   "end_sura_name": "آل عمران",
   "end_aya": 14,
   "end_of_sura": false,
   "end_words": "الدُّنْيَا وَاللَّهُ عِندَهُ حُسْنُ الْمَآبِ"
  },
  {
   "n": 6,
   "sura": 3,
   "sura_name": "آل عمران",
   "aya": 15,
   "start_of_sura": false,
   "words": "قُلْ أَؤُنَبِّئُكُم بِخَيْرٍ مِّن ذَٰلِكُمْ",
   "end_sura": 3,
   "end_sura_name": "آل عمران",
   "end_aya": 92,
   "end_of_sura": false,
   "end_words": "شَيْءٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ"
  },
  {
   "n": 7,
   "sura": 3,
   "sura_name": "آل عمران",
   "aya": 93,
   "start_of_sura": false,
   "words": "كُلُّ الطَّعَامِ كَانَ حِلًّا لِّبَنِي",
   "end_sura": 3,
   "end_sura_name": "آل عمران",
   "end_aya": 170,
   "end_of_sura": false,
   "end_words": "خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ"
  },
  {
   "n": 8,
   "sura": 3,
   "sura_name": "آل عمران",
   "aya": 171,
   "start_of_sura": false,
   "words": "يَسْتَبْشِرُونَ بِنِعْمَةٍ مِّنَ اللَّهِ وَفَضْلٍ",
   "end_sura": 4,
   "end_sura_name": "النساء",
   "end_aya": 23,
   "end_of_sura": false,
   "end_words": "إِنَّ اللَّهَ كَانَ غَفُورًا رَّحِيمًا"
  },
  {
   "n": 9,
   "sura": 4,
   "sura_name": "النساء",
   "aya": 24,
   "start_of_sura": false,
   "words": "وَالْمُحْصَنَاتُ مِنَ النِّسَاءِ إِلَّا مَا",
   "end_sura": 4,
   "end_sura_name": "النساء",
   "end_aya": 87,
   "end_of_sura": false,
   "end_words": "وَمَنْ أَصْدَقُ مِنَ اللَّهِ حَدِيثًا"
  },
  {
   "n": 10,
   "sura": 4,
   "sura_name": "النساء",
   "aya": 88,
   "start_of_sura": false,
   "words": "فَمَا لَكُمْ فِي الْمُنَافِقِينَ فِئَتَيْنِ",
   "end_sura": 4,
   "end_sura_name": "النساء",
   "end_aya": 147,
   "end_of_sura": false,
   "end_words": "وَآمَنتُمْ وَكَانَ اللَّهُ شَاكِرًا عَلِيمًا"
  },
  {
   "n": 11,
   "sura": 4,
   "sura_name": "النساء",
   "aya": 148,
   "start_of_sura": false,
   "words": "لَّا يُحِبُّ اللَّهُ الْجَهْرَ بِالسُّوءِ",
   "end_sura": 5,
   "end_sura_name": "المائدة",
   "end_aya": 26,
   "end_of_sura": false,
   "end_words": "فَلَا تَأْسَ عَلَى الْقَوْمِ الْفَاسِقِينَ"
  },
  {
   "n": 12,
   "sura": 5,
   "sura_name": "المائدة",
   "aya": 27,
   "start_of_sura": false,
   "words": "وَاتْلُ عَلَيْهِمْ نَبَأَ ابْنَيْ آدَمَ",
   "end_sura": 5,
   "end_sura_name": "المائدة",
   "end_aya": 81,
   "end_of_sura": false,
   "end_words": "أَوْلِيَاءَ وَلَٰكِنَّ كَثِيرًا مِّنْهُمْ فَاسِقُونَ"
  },
  {
   "n": 13,
   "sura": 5,
   "sura_name": "المائدة",
   "aya": 82,
   "start_of_sura": false,
   "words": "لَتَجِدَنَّ أَشَدَّ النَّاسِ عَدَاوَةً لِّلَّذِينَ",
   "end_sura": 6,
   "end_sura_name": "الأنعام",
   "end_aya": 35,
   "end_of_sura": false,
   "end_words": "الْهُدَىٰ فَلَا تَكُونَنَّ مِنَ الْجَاهِلِينَ"
  },
  {
   "n": 14,
   "sura": 6,
   "sura_name": "الأنعام",
   "aya": 36,
   "start_of_sura": false,
   "words": "إِنَّمَا يَسْتَجِيبُ الَّذِينَ يَسْمَعُونَ وَالْمَوْتَىٰ",
   "end_sura": 6,
   "end_sura_name": "الأنعام",
   "end_aya": 110,
   "end_of_sura": false,
   "end_words": "مَرَّةٍ وَنَذَرُهُمْ فِي طُغْيَانِهِمْ يَعْمَهُونَ"
  },
  {
   "n": 15,
   "sura": 6,
   "sura_name": "الأنعام",
   "aya": 111,
   "start_of_sura": false,
   "words": "وَلَوْ أَنَّنَا نَزَّلْنَا إِلَيْهِمُ الْمَلَائِكَةَ",
   "end_sura": 6,
   "end_sura_name": "الأنعام",
   "end_aya": 165,
   "end_of_sura": true,
   "end_words": "سَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَّحِيمٌ"
  },
  {
   "n": 16,
   "sura": 7,
   "sura_name": "الأعراف",
   "aya": 1,
   "start_of_sura": true,
   "words": "المص كِتَابٌ أُنزِلَ إِلَيْكَ فَلَا",
   "end_sura": 7,
   "end_sura_name": "الأعراف",
   "end_aya": 87,
   "end_of_sura": false,
   "end_words": "اللَّهُ بَيْنَنَا وَهُوَ خَيْرُ الْحَاكِمِينَ"
  },
  {
   "n": 17,
   "sura": 7,
   "sura_name": "الأعراف",
   "aya": 88,
   "start_of_sura": false,
   "words": "قَالَ الْمَلَأُ الَّذِينَ اسْتَكْبَرُوا مِن",
   "end_sura": 7,
   "end_sura_name": "الأعراف",
   "end_aya": 170,
   "end_of_sura": false,
   "end_words": "إِنَّا لَا نُضِيعُ أَجْرَ الْمُصْلِحِينَ"
