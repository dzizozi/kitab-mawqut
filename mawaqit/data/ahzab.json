  {
   "n": 29,
   "sura": 17,
   "sura_name": "الإسراء",
   "aya": 1,
   "start_of_sura": true,
   "words": "سُبْحَانَ الَّذِي أَسْرَىٰ بِعَبْدِهِ لَيْلًا",
   "end_sura": 17,
   "end_sura_name": "الإسراء",
   "end_aya": 98,
   "end_of_sura": false,
