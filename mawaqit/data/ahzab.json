  {
   "n": 33,
   "sura": 21,
   "sura_name": "الأنبياء",
   "aya": 1,
   "start_of_sura": true,
   "words": "اقْتَرَبَ لِلنَّاسِ حِسَابُهُمْ وَهُمْ فِي",
   "end_sura": 21,
   "end_sura_name": "الأنبياء",
   "end_aya": 112,
   "end_of_sura": true,
   "end_words": "الرَّحْمَٰنُ الْمُسْتَعَانُ عَلَىٰ مَا تَصِفُونَ"
