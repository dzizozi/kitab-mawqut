  {
   "n": 24,
   "sura": 11,
   "sura_name": "هود",
   "aya": 84,
   "start_of_sura": false,
   "words": "وَإِلَىٰ مَدْيَنَ أَخَاهُمْ شُعَيْبًا قَالَ",
