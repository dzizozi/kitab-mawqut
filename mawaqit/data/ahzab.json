   "words": "يَا أَيُّهَا الَّذِينَ آمَنُوا لَا"
  },
  {
   "end_of_sura": false,
   "end_sura": 26,
   "end_sura_name": "الشعراء",
   "end_aya": 110,
   "end_words": "فَاتَّقُوا اللَّهَ وَأَطِيعُونِ",
   "n": 37,
   "sura": 25,
   "sura_name": "الفرقان",
   "aya": 21,
   "start_of_sura": false,
   "words": "وَقَالَ الَّذِينَ لَا يَرْجُونَ لِقَاءَنَا"
  },
  {
   "end_of_sura": false,
   "end_sura": 27,
   "end_sura_name": "النمل",
   "end_aya": 55,
   "end_words": "النِّسَاءِ بَلْ أَنتُمْ قَوْمٌ تَجْهَلُونَ",
   "n": 38,
   "sura": 26,
   "sura_name": "الشعراء",
   "aya": 111,
   "start_of_sura": false,
   "words": "قَالُوا أَنُؤْمِنُ لَكَ وَاتَّبَعَكَ الْأَرْذَلُونَ"
